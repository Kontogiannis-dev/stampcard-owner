# Copy this file to .env and adjust the values.

# Base URL of the backend API. Defaults to http://localhost:8000 when unset.
# VITE_API_URL=http://localhost:8000

# Optional. Paths to a local HTTPS certificate and key (for example from mkcert).
# When both are unset, the dev server uses plain HTTP.
# CERT_PATH=
# KEY_PATH=